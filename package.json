{
	"name": "holakirr-cv",
	"version": "1.0.0",
	"private": true,
	"author": "Kirill Petunin",
	"scripts": {
		"dev": "next dev -p 3001",
		"build": "next build",
		"start": "next start -p 3001",
		"lint": "biome check .",
		"format": "biome format . --write",
		"tolgee:pull": "tolgee pull --api-key $NEXT_PUBLIC_TOLGEE_API_KEY",
		"tolgee:push": "tolgee push --api-key $NEXT_PUBLIC_TOLGEE_API_KEY",
		"cv:snapshot": "node --experimental-strip-types scripts/snapshot-cv.mjs && biome format --write lib/cv-snapshot.ts",
		"cv:pdf": "node scripts/render-pdf.mjs"
	},
	"packageManager": "bun@1.3.11",
	"dependencies": {
		"@holakirr/snow-ui": "^2.0.2",
		"@holakirr/snow-ui-icons": "^2.0.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@tolgee/react": "^7.2.1",
		"@types/node": "26.6.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"autoprefixer": "10.6.1",
		"clsx": "^2.1.1",
		"next": "^16.3.5",
		"postcss": "8.5.28",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"sass": "^1.104.1",
		"tailwindcss": "^4.3.3",
		"typescript": "7.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@tolgee/cli": "^2.20.0",
		"baseline-browser-mapping": "^2.11.25"
	}
}
